# Upstage API key. Required only for server-side AI features.
UPSTAGE_API_KEY=

# Optional model name. Keep the default in application code when empty.
UPSTAGE_MODEL=

# Supabase project URL. Required for browser and server clients.
NEXT_PUBLIC_SUPABASE_URL=

# Preferred public browser key. Use this or the legacy anon key below.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Legacy public browser key supported by existing Supabase projects.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Vercel Supabase Integration aliases. The server client accepts these names;
# never expose secret or service-role keys with a NEXT_PUBLIC_ prefix.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

SUPABASE_JWT_SECRET=
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

POSTGRES_DATABASE=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_PRISMA_URL=
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
