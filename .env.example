# Upstage API key. Required only for server-side AI features.
UPSTAGE_API_KEY=

# Optional Document OCR model. Keep the `ocr` default in application code when empty.
UPSTAGE_OCR_MODEL=

# Optional server-only OCR endpoint override for local integration tests.
UPSTAGE_OCR_URL=

# Base64-encoded Modusign Basic auth value (email:API key). Server/MCP only.
MODUSIGN_AUTH_KEY=

# Modusign template used for donation pledge signing. Server only.
MODUSIGN_TEMPLATE_ID=

# Shared secret sent in the Modusign webhook custom header. Server only.
MODUSIGN_WEBHOOK_SECRET=

# Public HTTPS deployment origin used for Modusign completion redirects.
# Example: https://your-project.vercel.app
NEXT_PUBLIC_SITE_URL=

# Local/Preview-only credentials consumed by `npm run demo:accounts`.
# Never commit real values or configure these for Production.
DEMO_DONOR_EMAIL=
DEMO_DONOR_PASSWORD=
DEMO_ORGANIZATION_EMAIL=
DEMO_ORGANIZATION_PASSWORD=
DEMO_ORGANIZATION_SIGNER_NAME=
DEMO_ORGANIZATION_SLUG=haebom
# Optional pledge UUID used by `npm run verify:rls`.
RLS_PLEDGE_ID=
# Optional accounts used to extend `npm run verify:rls` role coverage.
RLS_VIEWER_EMAIL=
RLS_VIEWER_PASSWORD=
RLS_OTHER_ORGANIZATION_EMAIL=
RLS_OTHER_ORGANIZATION_PASSWORD=

# Required before collecting resident registration numbers.
PLEDGE_IDENTITY_NUMBER_ENABLED=false
PLEDGE_PII_ENCRYPTION_KEY=

# Supabase project URL. Required for browser and server clients.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable key. Required for browser and server clients.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase secret key. Required only by server-side plan and execution mutation routes.
SUPABASE_SECRET_KEY=
