# Upstage API key. Required only for server-side AI features.
UPSTAGE_API_KEY=

# Optional model name. Keep the default in application code when empty.
UPSTAGE_MODEL=

# Optional server-only OCR endpoint override for local integration tests.
UPSTAGE_OCR_URL=

# Supabase project URL. Required for browser and server clients.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable key. Required for browser and server clients.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase secret key. Required only by server-side plan mutation routes.
SUPABASE_SECRET_KEY=
